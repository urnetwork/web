
user www-data;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;


# target concurrent users (from sites.yml): 589824
# https://www.nginx.com/blog/tuning-nginx/
worker_processes auto;
events {
    worker_connections 8192;
    multi_accept on;
}


http {
    ##
    # Basic Settings
    ##

    sendfile on;
    # minimize latency
    tcp_nodelay on;
    tcp_nopush off;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ##
    # Logging Settings
    ##

    # Privacy-safe page analytics. Cloudflare resolves the client address to a
    # country before the request reaches us. The origin never exports the
    # address (or a hash of it): it accepts only a structurally valid country
    # code accompanied by a Cloudflare Ray id, and otherwise records ZZ.
    #
    # Keep the public origins Cloudflare-only. These headers are metadata, not
    # authentication, so a directly reachable origin would let a caller spoof
    # the aggregate country bucket (still without exposing a user identifier).
    map "$http_cf_ray:$http_cf_ipcountry" $analytics_region {
        default "ZZ";
        "~^[0-9A-Fa-f]{16,32}-[A-Za-z]{3}:(?<analytics_country>[A-Z]{2})$" $analytics_country;
    }

    # /ip has a small machine-readable representation in addition to its HTML
    # page. Cloudflare terminates the public ur.io connection, so its
    # CF-Connecting-IP is the address the caller actually used; require a
    # structurally valid Ray id before considering that header. Direct and
    # preview traffic falls back to Warp's ingress-owned ip:port header, then
    # finally to the socket peer. Every accepted character is JSON-safe.
    map "$http_cf_ray:$http_cf_connecting_ip" $cloudflare_client_ip {
        default "";
        "~^[0-9A-Fa-f]{16,32}-[A-Za-z]{3}:(?<cf_client_ipv4>(?:[0-9]{1,3}\.){3}[0-9]{1,3})$" $cf_client_ipv4;
        "~^[0-9A-Fa-f]{16,32}-[A-Za-z]{3}:(?<cf_client_ipv6>[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]+)$" $cf_client_ipv6;
    }

    map $http_x_ur_forwarded_for $forwarded_client_ip {
        default "";
        "~^(?<forwarded_client_ipv4>(?:[0-9]{1,3}\.){3}[0-9]{1,3}):[0-9]{1,5}$" $forwarded_client_ipv4;
        "~^\[(?<forwarded_client_ipv6>[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]+)\]:[0-9]{1,5}$" $forwarded_client_ipv6;
        # Compatibility with the pre-bracketing Warp header. Its contract made
        # the final decimal group the source port, so split at the last colon.
        "~^(?<forwarded_client_legacy_ipv6>[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]+):[0-9]{1,5}$" $forwarded_client_legacy_ipv6;
    }

    map $cloudflare_client_ip $preferred_client_ip {
        default $cloudflare_client_ip;
        "" $forwarded_client_ip;
    }

    map $preferred_client_ip $ip_response_address {
        default $preferred_client_ip;
        "" $remote_addr;
    }

    # Accept is the response-content negotiation header. A request-body
    # Content-Type on this GET route does not select the representation.
    # Honor application/json and structured +json media types unless that
    # media range was explicitly disabled with q=0.
    map $http_accept $accepts_json {
        default 0;
        "~*(?:^|,)[[:space:]]*application/(?:[a-z0-9!#$&^_.+-]+\+)?json(?:(?:[[:space:]]*;)(?![^,]*\bq=0(?:\.0*)?(?![0-9.]))[^,]*)?[[:space:]]*(?:,|$)" 1;
    }

    map "$request_method:$accepts_json" $ip_json_requested {
        default 0;
        "GET:1" 1;
        "HEAD:1" 1;
    }

    # Reduce Referer to a small source/engine vocabulary in nginx memory. The
    # original value never enters stdout, a queue, Prometheus, or Loki.
    map $http_referer $analytics_source {
        default "referral";
        "" "direct";

        ~*^https?://([^/]+\.)?gemini\.google\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?(chatgpt\.com|chat\.openai\.com)(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?claude\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?copilot\.microsoft\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?perplexity\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?grok\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?meta\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?you\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?poe\.com(?::[0-9]+)?(?:/|$) "ai";

        ~*^https?://([^/]+\.)?google\.[^/:]+(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?bing\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?duckduckgo\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?baidu\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?yandex\.[^/:]+(?::[0-9]+)?(?:/|$) "search";
    }

    map $http_referer $analytics_engine {
        default "other";
        "" "none";

        ~*^https?://([^/]+\.)?gemini\.google\.com(?::[0-9]+)?(?:/|$) "gemini";
        ~*^https?://([^/]+\.)?(chatgpt\.com|chat\.openai\.com)(?::[0-9]+)?(?:/|$) "openai";
        ~*^https?://([^/]+\.)?claude\.ai(?::[0-9]+)?(?:/|$) "anthropic";
        ~*^https?://([^/]+\.)?copilot\.microsoft\.com(?::[0-9]+)?(?:/|$) "copilot";
        ~*^https?://([^/]+\.)?perplexity\.ai(?::[0-9]+)?(?:/|$) "perplexity";
        ~*^https?://([^/]+\.)?grok\.com(?::[0-9]+)?(?:/|$) "xai";
        ~*^https?://([^/]+\.)?meta\.ai(?::[0-9]+)?(?:/|$) "meta";
        ~*^https?://([^/]+\.)?you\.com(?::[0-9]+)?(?:/|$) "you";
        ~*^https?://([^/]+\.)?poe\.com(?::[0-9]+)?(?:/|$) "poe";

        ~*^https?://([^/]+\.)?google\.[^/:]+(?::[0-9]+)?(?:/|$) "google";
        ~*^https?://([^/]+\.)?bing\.com(?::[0-9]+)?(?:/|$) "bing";
        ~*^https?://([^/]+\.)?duckduckgo\.com(?::[0-9]+)?(?:/|$) "duckduckgo";
        ~*^https?://([^/]+\.)?baidu\.com(?::[0-9]+)?(?:/|$) "baidu";
        ~*^https?://([^/]+\.)?yandex\.[^/:]+(?::[0-9]+)?(?:/|$) "yandex";
    }

    map $host $analytics_site {
        default "";
        ur.io "ur.io";
        ur.xyz "ur.xyz";
    }

    # $uri follows internal try_files redirects (for example /products becomes
    # /products.html). Derive the public path from immutable $request_uri and
    # stop before the query delimiter, so neither the query nor the internal
    # filename can reach analytics.
    map $request_uri $analytics_path {
        default "/";
        "~^(?<analytics_public_path>[^?]*)(?:[?].*)?$" $analytics_public_path;
    }

    # Count only successful public HTML GETs. Static assets, previews,
    # redirects, errors, and health checks are excluded.
    map "$request_method:$status:$sent_http_content_type:$analytics_site" $analytics_page_view {
        default 0;
        "~^GET:2[0-9][0-9]:text/html(?:;[^:]*)?:(?:ur\.io|ur\.xyz)$" 1;
    }

    log_format privacy_safe_page_view escape=json
        '{"event":"web_page_view","privacy_safe":true,'
        '"site":"$analytics_site","path":"$analytics_path","region":"$analytics_region",'
        '"source":"$analytics_source","engine":"$analytics_engine"}';
    access_log /dev/stdout privacy_safe_page_view if=$analytics_page_view;
    error_log stderr;

    ##
    # Gzip Settings
    ##

    # text/html is always compressed when gzip is on; everything else must be
    # listed. Without gzip_types, CSS/JS/SVG/sitemaps/llms.txt/markdown all went
    # over the wire uncompressed. woff2/png/mp4 are pre-compressed — leave out.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_vary on;
    # precompressed siblings from the site builds (astro/scripts/precompress.mjs
    # emits .br at brotli-11 and .gz at gzip-9 next to every text asset):
    # maximum-compression bytes with zero runtime CPU. brotli_static comes from
    # the ngx_brotli module compiled in the image (web/web/Dockerfile); the LB
    # forwards Accept-Encoding and passes encoded responses through untouched.
    gzip_static on;
    brotli_static on;
    gzip_types
        text/css
        application/javascript
        text/xml
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml
        text/plain
        text/markdown
        application/yaml
        application/json
        application/manifest+json
        application/wasm;

    # preview.* serves the same bytes as the public host. The HTML canonicals
    # already point at the public origin; this header keeps the duplicate host
    # out of indexes entirely. An empty value means the header is not sent.
    map $host $ur_preview_robots {
        default          "";
        preview.ur.io    "noindex, nofollow";
        preview.ur.xyz   "noindex, nofollow";
    }

    server {
        listen 80 default_server;

        absolute_redirect off;

        location =/status {
            alias /srv/warp/status/status.json;
            add_header 'Content-Type' 'application/json';
        }
    }

    # TLS terminates at the public load balancer. Direct ingress forwards the
    # public Host, while the bringyour.com CDN deliberately normalizes its
    # origin Host to main-web.bringyour.com. Keep the load-balancer status
    # endpoint and the transactional-email images available under either
    # identity, but retire the rest of the legacy site.
    server {
        listen 80;
        server_name bringyour.com main-web.bringyour.com main-web.ur.network;

        root /www/bringyour.com;

        location = /status {
            alias /srv/warp/status/status.json;
            add_header 'Content-Type' 'application/json';
        }

        # Server email templates use these stable absolute URLs. They remain a
        # live dependency after the legacy HTML site redirects to ur.io.
        location ^~ /res/emails/ {
            try_files $uri =404;
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
        }

        location / {
            return 301 https://ur.io$request_uri;
        }
    }

    # The legacy hosts use the same redirect for requests that entered through
    # either the public HTTP or HTTPS listener.
    server {
        listen 80;
        server_name www.bringyour.com ur.network www.ur.network;

        return 301 https://ur.io$request_uri;
    }

    server {
        listen 80;
        server_name www.ur.io;

        return 301 https://ur.io$request_uri;
    }

    server {
        listen 80;
        server_name www.ur.xyz;

        return 301 https://ur.xyz$request_uri;
    }

    server {
        listen 80;
        server_name ur.io preview.ur.io;

        absolute_redirect off;
        root /www/preview.ur.io;

        # A missing path serves the site's own 404 page with a real 404 status
        # instead of nginx's stock page. The page ships noindex.
        error_page 404 /404.html;

        # Exact match beats the .html-canonicalization regex below, and
        # `internal` keeps direct hits on /404.html out of the duplicate-URL
        # space: externally it 404s (which serves this same file via
        # error_page), internally it renders the branded page.
        location = /404.html {
            internal;
            add_header 'Cache-Control' 'no-cache';
        }

        # Serve the homepage file in this exact location. Letting `location /`
        # resolve the document root as a directory invokes nginx's index
        # module, which internally redirects to /index.html. That internal
        # lookup must not enter the public /index.html canonical redirect
        # below, or / permanently redirects to itself.
        location = / {
            try_files /index.html =404;

            # always check for updates in the background
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'Last-Modified' '{{ http_last_modified }}';
            add_header 'ETag' 'W/"{{ http_etag }}"';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # The build is flat files (products.html), but the public URL space is
        # clean (/products). Collapse the .html twins and trailing-slash
        # variants onto the canonical form with real 301s.
        location = /index.html {
            return 301 /;
        }

        # Retired paths, in every language: the UR node is sold at shop.ur.io
        # and the protocol has its own site, ur.xyz.
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?urnode(?:\.html|/)?$ {
            return 301 https://shop.ur.io/;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?protocol(?:\.html|/)?$ {
            return 301 https://ur.xyz/;
        }

        # /404 is the not-found page's own URL: answer it with a 404 (which
        # error_page renders with that page) rather than a 200 copy of it.
        location = /404 {
            return 404;
        }

        # The code examples are English-only; their localized paths 301 to them.
        location ~ ^/(?:ru|ar|zh|de|es)(?<examples_path>/docs/examples(?:/.*)?)$ {
            return 301 $examples_path;
        }

        # Markdown and text twins of HTML pages, for agents: canonical to the
        # page they mirror, so the page is what search engines index. Ahead of
        # the generic machine-readable rule below, which they would otherwise
        # match first.
        location = /docs-md/index.md {
            add_header 'Link' '<https://ur.io/docs>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/docs-md/(?<md_lang>es|de|zh|ru|ar)/(?<md_slug>[a-z0-9-]+)\.md$ {
            add_header 'Link' '<https://ur.io/$md_lang/docs/$md_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/docs-md/(?<md_slug>[a-z0-9-]+)\.md$ {
            add_header 'Link' '<https://ur.io/docs/$md_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/blog-md/(?<md_lang>es|de|zh|ru|ar)/(?<md_slug>[a-z0-9-]+)\.md$ {
            add_header 'Link' '<https://ur.io/$md_lang/blog/$md_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/blog-md/(?<md_slug>[a-z0-9-]+)\.md$ {
            add_header 'Link' '<https://ur.io/blog/$md_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/(?<md_page>products|about|agents|changelog)\.md$ {
            add_header 'Link' '<https://ur.io/$md_page>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/llms(?:-full)?\.txt$ {
            add_header 'Link' '<https://ur.io/>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # mime.types has no entry for the web app manifest, which went out as
        # application/octet-stream.
        location = /site.webmanifest {
            types { application/manifest+json webmanifest; }
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # Keep /ip a browser page by default, while giving command-line and API
        # clients a one-field representation through ordinary HTTP content
        # negotiation. The internal status never escapes this server block.
        location = /ip {
            error_page 418 = @ip_json;
            if ($ip_json_requested) {
                return 418;
            }

            try_files /ip.html =404;

            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'Last-Modified' '{{ http_last_modified }}';
            add_header 'ETag' 'W/"{{ http_etag }}"';
            add_header 'Vary' 'Accept' always;
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location @ip_json {
            default_type application/json;
            add_header 'Cache-Control' 'no-store' always;
            add_header 'Vary' 'Accept' always;
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            return 200 '{"ip":"$ip_response_address"}';
        }

        # The feed is advertised everywhere as /blog/rss.xml; the bare /blog/rss
        # twin used to ship as a byte-identical duplicate.
        location = /blog/rss {
            return 301 /blog/rss.xml;
        }

        # Universal Links / password AutoFill discovery. Apple fetches this
        # extensionless path and wants JSON.
        location = /.well-known/apple-app-site-association {
            default_type application/json;
            add_header 'Cache-Control' 'max-age=3600';
        }

        # Content-hashed bundles never change under the same name.
        location ^~ /_astro/ {
            add_header 'Cache-Control' 'public, max-age=31536000, immutable';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # The onboarding emails' feedback links carry their token in the
        # path (/f/<token>?r=n); the site builds one page for all of them
        # (astro src/pages/f.astro → /f.html) and the island reads the token.
        location ^~ /f/ {
            try_files /f.html =404;
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' 'noindex, nofollow' always;
        }

        location ~ ^(?<clean>.+)/$ {
            return 301 $clean$is_args$args;
        }

        location ~ ^(?<clean>.+)\.html$ {
            return 301 $clean$is_args$args;
        }

        # Media and fonts: stable-named, safe to hold for a month.
        location ~* \.(?:png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|mp4|mp3|wasm)$ {
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # Machine-readable surfaces (sitemaps, feeds, llms.txt, markdown
        # twins, openapi): fresh within the hour without hammering.
        location ~* \.(?:xml|txt|md|ya?ml|json)$ {
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location / {
            try_files $uri $uri.html $uri/ $uri/index.html =404;

            # always check for updates in the background
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'Last-Modified' '{{ http_last_modified }}';
            add_header 'ETag' 'W/"{{ http_etag }}"';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }
    }

    server {
        listen 80;
        server_name ur.xyz preview.ur.xyz;

        absolute_redirect off;
        root /www/preview.ur.xyz;

        # A missing path serves the site's own 404 page with a real 404 status
        # instead of nginx's stock page. The page ships noindex.
        error_page 404 /404.html;

        location = /404.html {
            internal;
            add_header 'Cache-Control' 'no-cache';
        }

        # Keep the homepage lookup in this location rather than internally
        # redirecting it through the public /index.html canonical redirect.
        location = / {
            try_files /index.html =404;

            # always check for updates in the background
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'Last-Modified' '{{ http_last_modified }}';
            add_header 'ETag' '"{{ http_etag }}"';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /index.html {
            return 301 /;
        }

        # /404 is the not-found page's own URL: answer it with a 404 (which
        # error_page renders with that page) rather than a 200 copy of it.
        location = /404 {
            return 404;
        }

        # Retired aliases: the build ships noindex meta-refresh stubs as a
        # fallback, but a real 301 passes signals properly and skips a hop.
        location = /docs/whitepaper {
            return 301 /docs/litepaper;
        }

        # The docs corpus is four documents, /docs/miner, /docs/validator,
        # /docs/operator and /docs/litepaper (2026-09-25). Each retired document,
        # with its .html and trailing-slash variants and its localized paths,
        # 301s to the document that replaced it or to the index; the markdown
        # twins under /docs-md follow their pages.
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/provider(?:\.html|/.*)?$ {
            return 301 /docs/miner;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/protocol/protocol-research(?:\.html|/)?$ {
            return 301 /research;
        }

        # the trust-and-safety document is the miner guide's "Safety rules"
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/trust-and-safety/trust-and-safety(?:\.html|/)?$ {
            return 301 "/docs/miner#safety-rules";
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/archive/whitepaper(?:\.html|/)?$ {
            return 301 /docs/litepaper;
        }

        # the platform guides (CLI, EdgeOS, RouterOS, Raspberry Pi) folded into the miner guide
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/(?:cli|edgeos|routeros|rpi)(?:\.html|/.*)?$ {
            return 301 /docs/miner;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/(?:economic-model|changelog|mcp|router|protocol|trust-and-safety|archive)(?:\.html|/.*)?$ {
            return 301 /docs;
        }

        location = /docs-md/provider.md {
            return 301 /docs-md/miner.md;
        }

        location = /docs-md/protocol/protocol-research.md {
            return 301 /research;
        }

        location = /docs-md/archive/whitepaper.md {
            return 301 /docs-md/litepaper.md;
        }

        location ~ ^/docs-md/(?:cli|edgeos|routeros|rpi|economic-model|changelog|mcp|router|protocol|trust-and-safety|archive|provider)(?:/.*)?\.md$ {
            return 301 /docs;
        }

        location = /investors/august-investment-letter {
            return 301 /investors/our-letter-to-bittensor;
        }

        # The legal documents are English-only pages at /terms, /privacy and
        # /vdp: their localized paths and the docs corpus copies (/docs/legal/*,
        # /<lang>/docs/legal/*) are the same document, so they 301 there in one
        # hop. Ahead of the localized-docs rule below, which would add a hop.
        location ~ ^/(?:(?:ru|ar|zh|de|es)(?:/docs/legal)?|docs/legal)/(?<legal_doc>terms|privacy|vdp)(?:\.html|/)?$ {
            return 301 /$legal_doc;
        }

        # Docs are English-only; the localized docs URLs are redirect stubs.
        # Serve the redirect at the HTTP layer instead of via meta refresh.
        location ~ ^/(?:ru|ar|zh|de|es)/docs(?<docpath>/.*)?$ {
            return 301 /docs$docpath;
        }

        # The about, build, investor and price pages are English-only too:
        # their localized paths 301 to the page.
        location ~ ^/(?:ru|ar|zh|de|es)/(?<en_page>about|build|investors|price)(?<en_rest>/.*)?$ {
            return 301 /$en_page$en_rest$is_args$args;
        }

        # The investor documents' PDFs are printouts of HTML pages. They stay
        # downloads, and point search engines at the page they print.
        location = /investors/ur-investor-deck.pdf {
            add_header 'Link' '<https://ur.xyz/investors/deck>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/our-letter-to-bittensor.pdf {
            add_header 'Link' '<https://ur.xyz/investors/our-letter-to-bittensor>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/ur-conviction-lock-announcement.pdf {
            add_header 'Link' '<https://ur.xyz/investors/conviction-lock>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/ur-letter-to-tokenholders-september-2026.pdf {
            add_header 'Link' '<https://ur.xyz/investors/letter-to-tokenholders-september-2026>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # Markdown and text twins of HTML pages, for agents: canonical to the
        # page they mirror, so the page is what search engines index. Ahead of
        # the generic machine-readable rule below, which they would otherwise
        # match first.
        location ~ ^/docs-md/(?<doc_slug>[A-Za-z0-9/_.-]+)\.md$ {
            add_header 'Link' '<https://ur.xyz/docs/$doc_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /litepaper.md {
            add_header 'Link' '<https://ur.xyz/docs/litepaper>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^/llms(?:-full)?\.txt$ {
            add_header 'Link' '<https://ur.xyz/>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # mime.types has no entry for the web app manifest, which went out as
        # application/octet-stream.
        location = /site.webmanifest {
            types { application/manifest+json webmanifest; }
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ^~ /_astro/ {
            add_header 'Cache-Control' 'public, max-age=31536000, immutable';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~ ^(?<clean>.+)/$ {
            return 301 $clean$is_args$args;
        }

        location ~ ^(?<clean>.+)\.html$ {
            return 301 $clean$is_args$args;
        }

        location ~* \.(?:png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|mp4|mp3|pdf)$ {
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location ~* \.(?:xml|txt|md|ya?ml|json)$ {
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location / {
            try_files $uri $uri.html $uri/ $uri/index.html =404;

            # always check for updates in the background
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'Last-Modified' '{{ http_last_modified }}';
            add_header 'ETag' '"{{ http_etag }}"';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }
    }
}
