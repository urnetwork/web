
user www-data;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;


# target concurrent users (from sites.yml): 589824
# https://www.nginx.com/blog/tuning-nginx/
worker_processes auto;
events {
    worker_connections 8192;
    multi_accept on;
}


http {
    ##
    # Basic Settings
    ##

    sendfile on;
    # minimize latency
    tcp_nodelay on;
    tcp_nopush off;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Every text file these sites serve is UTF-8, and the Content-Type says
    # so. Without the parameter, clients such as Python requests decode
    # text/plain and its kin as ISO-8859-1, and RFC 7763 requires it on
    # text/markdown. text/html always gets it.
    charset utf-8;
    charset_types
        text/plain
        text/markdown
        text/xml
        text/css
        application/javascript
        application/json
        application/yaml
        application/rss+xml
        application/xml
        application/manifest+json;

    ##
    # Logging Settings
    ##

    # Privacy-safe page analytics. Cloudflare resolves the client address to a
    # country before the request reaches us. The origin never exports the
    # address (or a hash of it): it accepts only a structurally valid country
    # code accompanied by a Cloudflare Ray id, and otherwise records ZZ.
    #
    # Keep the public origins Cloudflare-only. These headers are metadata, not
    # authentication, so a directly reachable origin would let a caller spoof
    # the aggregate country bucket (still without exposing a user identifier).
    map "$http_cf_ray:$http_cf_ipcountry" $analytics_region {
        default "ZZ";
        "~^[0-9A-Fa-f]{16,32}-[A-Za-z]{3}:(?<analytics_country>[A-Z]{2})$" $analytics_country;
    }

    # Reduce Referer to a small source/engine vocabulary in nginx memory. The
    # original value never enters stdout, a queue, Prometheus, or Loki.
    map $http_referer $analytics_source {
        default "referral";
        "" "direct";

        ~*^https?://([^/]+\.)?gemini\.google\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?(chatgpt\.com|chat\.openai\.com)(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?claude\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?copilot\.microsoft\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?perplexity\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?grok\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?meta\.ai(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?you\.com(?::[0-9]+)?(?:/|$) "ai";
        ~*^https?://([^/]+\.)?poe\.com(?::[0-9]+)?(?:/|$) "ai";

        ~*^https?://([^/]+\.)?google\.[^/:]+(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?bing\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?duckduckgo\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?baidu\.com(?::[0-9]+)?(?:/|$) "search";
        ~*^https?://([^/]+\.)?yandex\.[^/:]+(?::[0-9]+)?(?:/|$) "search";
    }

    map $http_referer $analytics_engine {
        default "other";
        "" "none";

        ~*^https?://([^/]+\.)?gemini\.google\.com(?::[0-9]+)?(?:/|$) "gemini";
        ~*^https?://([^/]+\.)?(chatgpt\.com|chat\.openai\.com)(?::[0-9]+)?(?:/|$) "openai";
        ~*^https?://([^/]+\.)?claude\.ai(?::[0-9]+)?(?:/|$) "anthropic";
        ~*^https?://([^/]+\.)?copilot\.microsoft\.com(?::[0-9]+)?(?:/|$) "copilot";
        ~*^https?://([^/]+\.)?perplexity\.ai(?::[0-9]+)?(?:/|$) "perplexity";
        ~*^https?://([^/]+\.)?grok\.com(?::[0-9]+)?(?:/|$) "xai";
        ~*^https?://([^/]+\.)?meta\.ai(?::[0-9]+)?(?:/|$) "meta";
        ~*^https?://([^/]+\.)?you\.com(?::[0-9]+)?(?:/|$) "you";
        ~*^https?://([^/]+\.)?poe\.com(?::[0-9]+)?(?:/|$) "poe";

        ~*^https?://([^/]+\.)?google\.[^/:]+(?::[0-9]+)?(?:/|$) "google";
        ~*^https?://([^/]+\.)?bing\.com(?::[0-9]+)?(?:/|$) "bing";
        ~*^https?://([^/]+\.)?duckduckgo\.com(?::[0-9]+)?(?:/|$) "duckduckgo";
        ~*^https?://([^/]+\.)?baidu\.com(?::[0-9]+)?(?:/|$) "baidu";
        ~*^https?://([^/]+\.)?yandex\.[^/:]+(?::[0-9]+)?(?:/|$) "yandex";
    }

    map $host $analytics_site {
        default "";
        ur.xyz "ur.xyz";
    }

    # $uri follows internal try_files redirects (for example /products becomes
    # /products.html). Derive the public path from immutable $request_uri and
    # stop before the query delimiter, so neither the query nor the internal
    # filename can reach analytics.
    map $request_uri $analytics_path {
        default "/";
        "~^(?<analytics_public_path>[^?]*)(?:[?].*)?$" $analytics_public_path;
    }

    # Count only public HTML page views: successful GETs of HTML, and
    # revalidated ones, a 304 for a page's .html file ($uri after try_files),
    # which carries no Content-Type. Static assets, previews, redirects,
    # errors, and health checks are excluded.
    map "$request_method:$status:$sent_http_content_type:$analytics_site:$uri" $analytics_page_view {
        default 0;
        "~^GET:2[0-9][0-9]:text/html(?:;[^:]*)?:ur\.xyz:" 1;
        "~^GET:304::ur\.xyz:.*\.html$" 1;
    }

    log_format privacy_safe_page_view escape=json
        '{"event":"web_page_view","privacy_safe":true,'
        '"site":"$analytics_site","path":"$analytics_path","region":"$analytics_region",'
        '"source":"$analytics_source","engine":"$analytics_engine"}';
    access_log /dev/stdout privacy_safe_page_view if=$analytics_page_view;
    error_log stderr;

    ##
    # Gzip Settings
    ##

    # text/html is always compressed when gzip is on; everything else must be
    # listed. Without gzip_types, CSS/JS/SVG/sitemaps/llms.txt/markdown all went
    # over the wire uncompressed. woff2/png/mp4 are pre-compressed — leave out.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_vary on;
    # precompressed siblings from the site builds (astro/scripts/precompress.mjs
    # emits .br at brotli-11 and .gz at gzip-9 next to every text asset):
    # maximum-compression bytes with zero runtime CPU. brotli_static comes from
    # the ngx_brotli module compiled in the image (web/web/Dockerfile); the LB
    # forwards Accept-Encoding and passes encoded responses through untouched.
    gzip_static on;
    brotli_static on;
    gzip_types
        text/css
        application/javascript
        text/xml
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml
        text/plain
        text/markdown
        application/yaml
        application/json
        application/manifest+json
        application/wasm;

    # preview.* serves the same bytes as the public host. The HTML canonicals
    # already point at the public origin; this header keeps the duplicate host
    # out of indexes entirely. An empty value means the header is not sent.
    map $host $ur_preview_robots {
        default          "";
        preview.ur.xyz   "noindex, nofollow";
    }

    # The public machine-readable files (llms.txt, markdown twins, specs,
    # feeds, sitemaps) can be read from any origin. The warp load balancer
    # already sends Access-Control-Allow-Origin for the origins in the web
    # service's cors_origins (vault services.yml: https://ur.io, plus two
    # retired Framer previews), and nginx add_header appends rather than
    # replaces, so a second value would fail the browser's check for exactly
    # those origins: leave them to the load balancer. Should that list become
    # "*", drop these headers instead.
    map $http_origin $public_cors_origin {
        default          "*";
        "https://ur.io"  "";
    }

    server {
        listen 80 default_server;

        absolute_redirect off;

        location =/status {
            alias /srv/warp/status/status.json;
            add_header 'Content-Type' 'application/json';
        }
    }

    # Transitional. bringyour.com moved to the mmm service with the other mmm
    # sites (mmm/mmm/PLAN.md), but its CloudFront distribution still reaches the
    # origin as main-web.bringyour.com. Until that origin is switched to
    # main-mmm.bringyour.com, send its requests there, so the images the
    # server's emails link to under /res/emails/ keep loading. Remove this
    # block in the release after the switch.
    server {
        listen 80;
        server_name main-web.bringyour.com main-web.ur.network;

        location = /status {
            alias /srv/warp/status/status.json;
            add_header 'Content-Type' 'application/json';
        }

        location / {
            return 302 https://main-mmm.bringyour.com$request_uri;
        }
    }

    server {
        listen 80;
        server_name www.ur.xyz;

        return 301 https://ur.xyz$request_uri;
    }

    server {
        listen 80;
        server_name ur.xyz preview.ur.xyz;

        absolute_redirect off;
        root /www/preview.ur.xyz;

        # A missing path serves the site's own 404 page with a real 404 status
        # instead of nginx's stock page. The page ships noindex.
        error_page 404 /404.html;

        # A path with a backslash or a control character is a real 404, ahead
        # of every rule below. Redirects that echo the path would otherwise
        # send it back in their Location, and a browser reads /\example.com
        # and /<tab>/example.com as //example.com, another site; a CR would
        # break the header. $uri is decoded, so %5C and %09 are caught too.
        # nginx itself rejects %00 with a 400, before it picks a server.
        if ($uri ~ "[\x00-\x1f\x5c\x7f]") {
            return 404;
        }

        location = /404.html {
            internal;
            add_header 'Cache-Control' 'no-cache';
        }

        # Keep the homepage lookup in this location rather than internally
        # redirecting it through the public /index.html canonical redirect.
        location = / {
            try_files /index.html =404;

            # Always check for updates in the background. The validators are
            # nginx's own Last-Modified and ETag (the file's mtime and size):
            # its 304 check compares conditional requests with those, so a
            # hand-set Last-Modified or ETag never matched and every
            # revalidation got the whole page.
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /index.html {
            return 301 /;
        }

        # /404 is the not-found page's own URL: answer it with a 404 (which
        # error_page renders with that page) rather than a 200 copy of it.
        location = /404 {
            return 404;
        }

        # Likewise /index: the homepage's file is index.html, but its URL is
        # /, and `location /` below would serve a 200 copy of it at /index.
        location = /index {
            return 404;
        }

        # Retired aliases: the build ships noindex meta-refresh stubs as a
        # fallback, but a real 301 passes signals properly and skips a hop.
        location = /docs/whitepaper {
            return 301 /docs/litepaper;
        }

        # Retired sections of the earlier site, in every language and with
        # their .html and trailing-slash forms, 301 to their successors in
        # one hop. The provider and extender roles became the miner role,
        # whose page has localized copies, so they keep the language; the
        # other successors are English-only pages.
        location ~ ^(?<role_lang>/(?:ru|ar|zh|de|es))?/(?:providers|extenders)(?:\.html|/)?$ {
            return 301 $role_lang/miners;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?community(?:\.html|/)?$ {
            return 301 /about;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?api(?:\.html|/)?$ {
            return 301 /docs;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?roadmap(?:\.html|/)?$ {
            return 301 /investors;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?whitepaper(?:\.html|/)?$ {
            return 301 /docs/litepaper;
        }

        # where crawlers guess the sitemap
        location = /sitemap.xml {
            return 301 /sitemap-index.xml;
        }

        # The docs corpus is four documents, /docs/miner, /docs/validator,
        # /docs/operator and /docs/litepaper (2026-09-25). Each retired document,
        # with its .html and trailing-slash variants and its localized paths,
        # 301s to the document that replaced it or to the index; the markdown
        # twins under /docs-md follow their pages.
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/provider(?:\.html|/.*)?$ {
            return 301 /docs/miner;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/protocol/protocol-research(?:\.html|/)?$ {
            return 301 /research;
        }

        # the trust-and-safety document is the miner guide's "Safety rules"
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/trust-and-safety/trust-and-safety(?:\.html|/)?$ {
            return 301 "/docs/miner#safety-rules";
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/archive/whitepaper(?:\.html|/)?$ {
            return 301 /docs/litepaper;
        }

        # the platform guides (CLI, EdgeOS, RouterOS, Raspberry Pi) folded into the miner guide
        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/(?:cli|edgeos|routeros|rpi)(?:\.html|/.*)?$ {
            return 301 /docs/miner;
        }

        location ~ ^/(?:(?:ru|ar|zh|de|es)/)?docs/(?:economic-model|changelog|mcp|router|protocol|trust-and-safety|archive)(?:\.html|/.*)?$ {
            return 301 /docs;
        }

        location = /docs-md/provider.md {
            return 301 /docs-md/miner.md;
        }

        location = /docs-md/protocol/protocol-research.md {
            return 301 /research;
        }

        location = /docs-md/archive/whitepaper.md {
            return 301 /docs-md/litepaper.md;
        }

        location ~ ^/docs-md/(?:cli|edgeos|routeros|rpi|economic-model|changelog|mcp|router|protocol|trust-and-safety|archive|provider)(?:/.*)?\.md$ {
            return 301 /docs;
        }

        location = /investors/august-investment-letter {
            return 301 /investors/our-letter-to-bittensor;
        }

        # The legal documents are English-only pages at /terms, /privacy and
        # /vdp: their localized paths and the docs corpus copies (/docs/legal/*,
        # /<lang>/docs/legal/*) are the same document, so they 301 there in one
        # hop. Ahead of the localized-docs rule below, which would add a hop.
        location ~ ^/(?:(?:ru|ar|zh|de|es)(?:/docs/legal)?|docs/legal)/(?<legal_doc>terms|privacy|vdp)(?:\.html|/)?$ {
            return 301 /$legal_doc;
        }

        # Docs are English-only; the localized docs URLs are redirect stubs.
        # Serve the redirect at the HTTP layer instead of via meta refresh, in
        # one hop: the target leaves off a trailing slash or .html, which the
        # canonical rules below would otherwise redirect again.
        location ~ ^/(?:ru|ar|zh|de|es)/docs(?<docpath>/.*?[^/])?(?:\.html|/+)?$ {
            return 301 /docs$docpath;
        }

        # The about, build, investor, mainnet, price and reserve pages are
        # English-only too: their localized paths 301 to the page.
        location ~ ^/(?:ru|ar|zh|de|es)/(?<en_page>about|build|investors|mainnet|price|reserve)(?<en_rest>/.*)?$ {
            return 301 /$en_page$en_rest$is_args$args;
        }

        # The investor documents' PDFs are printouts of HTML pages. They stay
        # downloads, and point search engines at the page they print.
        location = /investors/ur-investor-deck.pdf {
            add_header 'Link' '<https://ur.xyz/investors/deck>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/our-letter-to-bittensor.pdf {
            add_header 'Link' '<https://ur.xyz/investors/our-letter-to-bittensor>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/ur-conviction-lock-announcement.pdf {
            add_header 'Link' '<https://ur.xyz/investors/conviction-lock>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/ur-letter-to-tokenholders-september-2026.pdf {
            add_header 'Link' '<https://ur.xyz/investors/letter-to-tokenholders-september-2026>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location = /investors/ur-network-capacity-letter.pdf {
            add_header 'Link' '<https://ur.xyz/investors/funding-network-capacity>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # Markdown and text twins of HTML pages, for agents: canonical to the
        # page they mirror, so the page is what search engines index. Ahead of
        # the generic machine-readable rule below, which they would otherwise
        # match first.
        location ~ ^/docs-md/(?<doc_slug>[A-Za-z0-9/_.-]+)\.md$ {
            add_header 'Link' '<https://ur.xyz/docs/$doc_slug>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            add_header 'Access-Control-Allow-Origin' $public_cors_origin always;
        }

        location = /litepaper.md {
            add_header 'Link' '<https://ur.xyz/docs/litepaper>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            add_header 'Access-Control-Allow-Origin' $public_cors_origin always;
        }

        # the legal documents' twins (scripts/generate-agent-assets.mjs)
        location ~ ^/(?<legal_doc>terms|privacy|vdp)\.md$ {
            add_header 'Link' '<https://ur.xyz/$legal_doc>; rel="canonical"';
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            add_header 'Access-Control-Allow-Origin' $public_cors_origin always;
        }

        # mime.types has no entry for the web app manifest, which went out as
        # application/octet-stream.
        location = /site.webmanifest {
            types { application/manifest+json webmanifest; }
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # The network operator list: the tracked copy of sn/operators.yml that
        # ur.xyz/scripts/sync-operators.mjs publishes. Miners and validators
        # refresh it hourly by default and keep their last good copy; the short
        # lifetime keeps a cached copy at most five minutes behind a change.
        # Only the file itself is served: anything else here is a 404, never a
        # redirect or a directory index.
        location = /operators.yml {
            types { application/yaml yml; }
            autoindex off;
            try_files $uri =404;
            add_header 'Cache-Control' 'public, max-age=300';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            add_header 'Access-Control-Allow-Origin' $public_cors_origin always;
        }

        # Content-hashed bundles never change under the same name. The load
        # balancer picks a block for each request, so during a staged rollout
        # a page's bundles may come from a block of the other release. This
        # image carries the bundles of the images deployed when it was built
        # (carry-hashed-assets.sh), so it serves an older page's bundles too.
        # A newer page's bundle is missing here: a 503, which no cache keeps
        # and the load balancer retries on the service's other block (warp's
        # proxy_next_upstream http_503, two tries), where the newer image
        # has it. A missing bundle that no block has ends as that 503.
        location ^~ /_astro/ {
            try_files $uri @hashed_asset_missing;
            add_header 'Cache-Control' 'public, max-age=31536000, immutable';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        location @hashed_asset_missing {
            add_header 'Cache-Control' 'no-store' always;
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            return 503;
        }

        # The .html twins and trailing-slash variants 301 to the clean URL,
        # with the host spelled out: a relative Location starts with the
        # request's own path, and a browser reads some paths, such as
        # /\example.com, as another host. $host is ur.xyz or preview.ur.xyz;
        # any other Host reaches the default server.
        location ~ ^(?<clean>.+)/$ {
            return 301 https://$host$clean$is_args$args;
        }

        location ~ ^(?<clean>.+)\.html$ {
            return 301 https://$host$clean$is_args$args;
        }

        # These locations and `location /` serve files and pages only, never
        # a directory. The build holds directories that are no page, such as
        # /audits and /docs-md. Given a directory, nginx's static handler
        # answers with a 301 that adds a slash, and the trailing-slash rule
        # above takes it off again, so those paths looped. Now a directory
        # with no page of its name is a 404, and its slashed form one
        # redirect to that. There is no directory index page but the
        # homepage: astro writes every page as a file (build.format "file").
        location ~* \.(?:png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|mp4|mp3|pdf)$ {
            try_files $uri =404;
            add_header 'Cache-Control' 'public, max-age=2592000, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }

        # Machine-readable surfaces (sitemaps, feeds, the price list and
        # feed, llms.txt, markdown twins): fresh within the hour without
        # hammering.
        location ~* \.(?:xml|txt|md|ya?ml|json|rss)$ {
            try_files $uri =404;
            add_header 'Cache-Control' 'public, max-age=3600, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
            add_header 'Access-Control-Allow-Origin' $public_cors_origin always;
        }

        location / {
            try_files $uri $uri.html =404;

            # always check for updates in the background, with nginx's own
            # validators (see location = /)
            add_header 'Cache-Control' 'max-age=0, stale-while-revalidate=86400';
            add_header 'X-Robots-Tag' $ur_preview_robots always;
        }
    }
}
