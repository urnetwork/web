---
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import FooterStatic from '../components/FooterStatic.astro';
import Section from '../components/Section.astro';
import NavIsland from '../islands/NavIsland.jsx';
import en from '@react/i18n/en.js';
import { contributors } from '../lib/contributors.js';

import '@react/components/Nav.css';

const description = 'About UR and the core contributors building the protocol, its applications and the network around them.';
---

<Base title="About | UR" description={description} lang="en">
    <div class="app about-page-shell">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="about" lang="en" client:load />

        <main id="main" class="about-page">
            <Section id="about-ur" eyebrow="Protocol" title="About" headingLevel="h1">
                <div class="about-ur-copy">
                    <p>
                        UR is an open-source protocol for building private internet applications on a global network of independent bandwidth providers. The first application is live at <a href="https://ur.io" target="_blank" rel="noopener noreferrer">ur.io</a>, with more ways to use the network in development. We believe everyone has a right to privacy and strong encryption, and that the infrastructure protecting those rights should be open, resilient and accessible to all.
                    </p>
                </div>
            </Section>

            <Section id="core-contributors" eyebrow="People" title="Core Contributors">
                <div class="core-contributor-list" aria-label="UR Core Contributors">
                    {contributors.map((person, index) => (
                        <article class="core-contributor" data-reveal>
                            <div class="core-contributor__portrait">
                                <img
                                    src={person.image}
                                    alt={`${person.name}, ${person.role} at UR`}
                                    width="400"
                                    height="400"
                                    loading={index === 0 ? 'eager' : 'lazy'}
                                    decoding="async"
                                />
                            </div>
                            <div class="core-contributor__identity">
                                <h3>{person.name}</h3>
                                <p>{person.role}</p>
                                <a href={person.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${person.name}'s ${person.platform} profile`}>
                                    {person.platform} <span aria-hidden="true">↗</span>
                                </a>
                            </div>
                            <p class="core-contributor__bio">{person.detail}</p>
                        </article>
                    ))}
                </div>
            </Section>

            <Section id="contribute" eyebrow="Contribute" title="Build UR with us">
                <div class="contribute-cta">
                    <p>UR is open source, with opportunities to contribute across the protocol, its applications and the network around them. If you want to contribute or explore joining the team, join us on Telegram.</p>
                    <a href="https://t.me/ursn25" target="_blank" rel="noopener noreferrer" aria-label="Join the UR community on Telegram">
                        <span>JOIN THE</span>
                        <span>COMMUNITY <i aria-hidden="true">↗</i></span>
                    </a>
                </div>
            </Section>
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>

<script>
    const revealItems = [...document.querySelectorAll('[data-reveal]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('has-reveal-motion');
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
            });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        revealItems.forEach((item) => revealObserver.observe(item));
    }
</script>

<style>
    :global(html) { scroll-behavior: smooth; }
    :global(body) { overflow-x: hidden; }
    :global(body:has(.about-page-shell)) { background: var(--brand-bg); }

    .about-page { padding-top: var(--nav-height, 64px); background: var(--brand-bg); color: var(--brand-ui); }
    .about-page :global(.section:first-of-type) { border-top: 0; }
    .about-page :global(#about-ur) { padding-bottom: 72px; }
    .about-page :global(#core-contributors) { padding-top: 72px; padding-bottom: 72px; }
    .about-page :global(#contribute) { padding-top: 72px; }

    .about-ur-copy { max-width: 68ch; }
    .about-ur-copy p { margin: 0; color: var(--brand-white); font-size: 1.12rem; line-height: 1.62; }
    .about-ur-copy a { color: var(--brand-ur); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
    .about-ur-copy a:hover { color: var(--brand-white); }
    .about-ur-copy a:focus-visible { outline: 2px solid var(--brand-ur); outline-offset: 4px; }

    .core-contributor-list { border-bottom: 1px solid rgba(214, 230, 244, 0.14); }
    .core-contributor { display: grid; grid-template-columns: 96px minmax(190px, 0.72fr) minmax(300px, 1.35fr); gap: 28px; align-items: center; min-height: 148px; padding: 26px 0; border-top: 1px solid rgba(214, 230, 244, 0.14); transition: background 0.2s ease; }
    .core-contributor:hover { background: rgba(237, 143, 255, 0.025); }
    .core-contributor__portrait { width: 96px; aspect-ratio: 1; overflow: hidden; border: 1px solid rgba(214, 230, 244, 0.22); background: rgba(237, 143, 255, 0.08); transition: border-color 0.25s ease, background 0.25s ease; }
    .core-contributor__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.78) saturate(0.5) brightness(0.74); transition: filter 0.28s ease; }
    .core-contributor:hover .core-contributor__portrait,
    .core-contributor:focus-within .core-contributor__portrait { border-color: rgba(237, 143, 255, 0.65); background: rgba(237, 143, 255, 0.14); }
    .core-contributor:hover .core-contributor__portrait img,
    .core-contributor:focus-within .core-contributor__portrait img { filter: grayscale(0) saturate(1.05) brightness(1); }
    .core-contributor__identity h3 { margin: 0 0 9px; color: var(--brand-white); font-size: clamp(1.75rem, 2.4vw, 2.15rem); font-weight: 400; line-height: 1; letter-spacing: -0.025em; }
    .core-contributor__identity p { margin: 0; color: var(--brand-ui); font-family: 'PPNeueBit', monospace; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .core-contributor__identity a { display: inline-flex; align-items: center; gap: 8px; min-width: 44px; min-height: 44px; margin-top: 4px; color: var(--brand-ur); font-size: 0.82rem; line-height: 1.4; text-decoration: none; }
    .core-contributor__identity a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
    .core-contributor__identity a:focus-visible { outline: 2px solid var(--brand-ur); outline-offset: 2px; }
    .core-contributor__bio { max-width: 54ch; margin: 0; color: var(--brand-ui); font-size: 1.05rem; line-height: 1.6; opacity: 0.9; }

    .contribute-cta { display: grid; grid-template-columns: minmax(0, 1.25fr) auto; gap: 56px; align-items: center; }
    .contribute-cta p { max-width: 61ch; margin: 0; color: var(--brand-ui); font-size: 1.08rem; line-height: 1.6; }
    .contribute-cta a { display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 2px; min-width: 230px; min-height: 72px; padding: 10px 24px; border: 1px solid var(--brand-ur); background: var(--brand-ur); color: var(--brand-bg); font-family: 'PPNeueMontreal', 'Montreal', sans-serif; font-size: 14px; font-weight: 600; line-height: 1.05; letter-spacing: 0.07em; text-align: center; text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease; }
    .contribute-cta a span { display: block; }
    .contribute-cta a i { font-style: normal; }
    .contribute-cta a:hover { border-color: var(--brand-white); background: var(--brand-white); }
    .contribute-cta a:focus-visible { outline: 2px solid var(--brand-ur); outline-offset: 4px; }

    .has-reveal-motion .core-contributor[data-reveal] { opacity: 0; transform: translateY(16px); transition: opacity 0.42s ease, transform 0.42s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.2s ease; }
    .has-reveal-motion .core-contributor[data-reveal].is-visible { opacity: 1; transform: translateY(0); }

    @media (max-width: 820px) {
        .about-page :global(#about-ur) { padding-bottom: 52px; }
        .about-page :global(#core-contributors) { padding-top: 52px; padding-bottom: 52px; }
        .about-page :global(#contribute) { padding-top: 52px; }
        .core-contributor { grid-template-columns: 84px minmax(0, 1fr); gap: 18px 20px; align-items: start; padding: 26px 0 30px; }
        .core-contributor__portrait { grid-column: 1; grid-row: 1; width: 84px; }
        .core-contributor__identity { grid-column: 2; grid-row: 1; align-self: center; }
        .core-contributor__bio { grid-column: 1 / -1; margin-top: 2px; }
        .contribute-cta { grid-template-columns: 1fr; gap: 32px; }
    }

    @media (max-width: 520px) {
        .about-ur-copy p { font-size: 1.03rem; line-height: 1.58; }
        .core-contributor { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 22px 0 26px; }
        .core-contributor__portrait { width: 72px; }
        .core-contributor__identity h3 { font-size: clamp(1.55rem, 8vw, 1.75rem); }
        .core-contributor__bio { font-size: 1rem; line-height: 1.58; }
        .contribute-cta { gap: 28px; }
        .contribute-cta p { font-size: 1rem; line-height: 1.58; }
        .contribute-cta a { width: 100%; min-width: 0; }
    }

    @media (hover: none) {
        .core-contributor__portrait img { filter: grayscale(0.55) saturate(0.65) brightness(0.82); }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
        .core-contributor,
        .core-contributor__portrait,
        .core-contributor__portrait img,
        .contribute-cta a { transition: none; }
    }
</style>
