---
// 404 — static not-found page. noindex: an error page is never a search result.
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — UR" description="This page does not exist." lang="en" noindex>
    <div style="min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 48px 20px;">
        <p style="font-size: 64px; margin: 0; font-family: 'PPNeueBit', monospace;">404</p>
        <p style="opacity: 0.7; margin: 0;">This page does not exist.</p>
        <a href="/" style="margin-top: 8px; text-decoration: underline;">Back to UR</a>
    </div>
</Base>
