---
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import FooterStatic from '../components/FooterStatic.astro';
import RoleBlocks from '../components/RoleBlocks.astro';
import HeroIsland from '../islands/HeroIsland.jsx';
import LaunchVideoIsland from '../islands/LaunchVideoIsland.jsx';
import HomepageIntro from '@react/components/HomepageIntro.jsx';
import NetworkDiagram from '@react/components/NetworkDiagram.jsx';
import en from '@react/i18n/en.js';

const t = en;
---
<Base title="UR | Own ur privacy. Own the network." lang="en">
    <div class="app">
        <DisclaimerStatic t={t} />
        <HeroIsland lang="en" client:load />

        <main class="landing-main">
            <HomepageIntro copy={t} />
            <section class="landing-overview" aria-label={t.homepage.diagramAria}>
                <NetworkDiagram client:load active="subnet" lang="en" />
                <RoleBlocks t={t} lang="en" />
            </section>
        </main>

        <FooterStatic t={t} lang="en" />
        <LaunchVideoIsland lang="en" client:load />
    </div>
</Base>

<style>
    .landing-main { position: relative; background: var(--brand-bg); }
    .landing-overview { width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 120px 0 0; }
    @media (max-width: 767px) {
        .landing-overview { width: calc(100% - 40px); padding-top: 88px; }
    }
</style>
