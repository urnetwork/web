---
import en from '@react/i18n/en.js';

interface Props { t?: any; }
const { t = en } = Astro.props;
---
<div class="disclaimer" id="disclaimer-bar">
    <p class="disclaimer-copy">
        <span>{t.disclaimer.before}</span><a href="https://ur.io" target="_blank" rel="noopener noreferrer">ur.io</a>
    </p>
</div>

<style is:global>
    .disclaimer {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-height);
        z-index: 51;
        background: rgba(16, 16, 16, 0.92);
        border-bottom: 1px solid rgba(214, 230, 244, 0.08);
        transition: transform 0.3s ease;
        overflow: hidden;
    }
    .disclaimer-hidden { transform: translateY(-100%); }
    .disclaimer-copy {
        display: flex;
        align-items: center;
        justify-content: center;
        column-gap: 0.35em;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 0 32px;
        color: var(--brand-ui);
        font-family: 'PPNeueMontreal', sans-serif;
        font-size: 0.68rem;
        line-height: 1.4;
        letter-spacing: 0.04em;
        opacity: 0.6;
        text-align: center;
        transition: opacity 0.2s ease;
    }
    .disclaimer-copy:hover { opacity: 1; }
    .disclaimer-copy a { color: var(--brand-white); text-underline-offset: 2px; }
    @media (max-width: 768px) {
        .disclaimer-copy { padding: 0 18px; font-size: 0.6875rem; line-height: 1.35; }
    }
    @media (max-width: 360px) {
        .disclaimer-copy { padding: 0 14px; font-size: 0.6875rem; }
    }
</style>

<script>
    const bar = document.getElementById('disclaimer-bar');
    let raf = 0;
    function update() {
        raf = 0;
        if (bar) bar.classList.toggle('disclaimer-hidden', window.scrollY > 8);
    }
    update();
    window.addEventListener('scroll', () => {
        if (!raf) raf = requestAnimationFrame(update);
    }, { passive: true });
</script>
