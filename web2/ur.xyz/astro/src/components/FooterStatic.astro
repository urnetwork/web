---
import '@react/components/Footer.css';
import { LANGS, LANG_CODES } from '../lib/i18n.js';
import { hasLocalizedVersion, resolveLanguageDestination } from '../lib/route-localization.js';

interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const year = new Date().getFullYear();
const GENERAL_DISCORD = 'https://discord.gg/urnetwork';
const TELEGRAM_URL = 'https://t.me/ursn25';
const X_URL = 'https://x.com/urnetwork';
const GITHUB_URL = 'https://github.com/urfoundation/sn';
const PRODUCT_URL = 'https://ur.io';
const BRAND_KIT = 'https://drive.google.com/drive/folders/1086NAso9dA9ytMC0Dg5LoKZ4RSxgcXD8?usp=sharing';
const currentPath = Astro.url.pathname;
const translated = hasLocalizedVersion(currentPath);

function path(name: string, slug: string | null = null) {
    const prefix = lang && lang !== 'en' ? `/${lang}` : '';
    if (name === 'home') return prefix || '/';
    if (name === 'docs' && slug) return `${prefix}/docs/${slug}`;
    return `${prefix}/${name}`;
}
---
<footer class="footer">
    <div class="footer-directory">
        <nav class="footer-column" aria-label={t.footer.learn}>
            <h2>{t.footer.learn}</h2>
            {/* docs are English-only — a localized href only reached them through a redirect stub */}
            <a href="/docs" aria-label={`${t.nav.docs} — available in English`}>{t.nav.docs} <span class="english-only-mark" lang="en">EN</span></a>
            <a href="/build" aria-label="Build on UR — available in English">Build on UR <span class="english-only-mark" lang="en">EN</span></a>
            <a href={path('research')}>{t.nav.research}</a>
            <a href="/about" aria-label="About — available in English">About <span class="english-only-mark" lang="en">EN</span></a>
            <a href="/docs/litepaper" aria-label={`${t.nav.whitepaper} — available in English`}>{t.nav.whitepaper} <span class="english-only-mark" lang="en">EN</span></a>
        </nav>

        <nav class="footer-column" aria-label={t.nav.network}>
            <h2>{t.nav.network}</h2>
            <a href={path('operators')}>{t.nav.operators}</a>
            <a href={path('miners')}>{t.nav.miners}</a>
            <a href={path('validators')}>{t.nav.validators}</a>
        </nav>

        <nav class="footer-column" aria-label={t.footer.resources}>
            <h2>{t.footer.resources}</h2>
            <a href={`${path('home')}#launch-video`}>{t.footer.launchVideo}</a>
            <a href={BRAND_KIT} target="_blank" rel="noopener noreferrer">{t.footer.brandKit}</a>
            <a href="/investors" aria-label="Investor Centre — available in English">Investor Centre <span class="english-only-mark" lang="en">EN</span></a>
            {/* machine-readable site map for agents (the llms.txt convention) */}
            <a href="/llms.txt">llms.txt</a>
        </nav>
    </div>

    <nav class="footer-socials" aria-label="Community and social links">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" aria-label="URnetwork on X" title="X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.826l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" /></svg>
        </a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="UR subnet on Telegram" title="Telegram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.91 3.79 20.3 20.84c-.25 1.21-.99 1.5-2.01.93l-5.5-4.05-2.65 2.55c-.29.29-.54.54-1.1.54l.39-5.6 10.2-9.22c.44-.39-.1-.61-.69-.22L6.33 13.71.9 12.01c-1.18-.37-1.2-1.18.25-1.75L22.36 2.1c.98-.36 1.84.24 1.55 1.69Z" /></svg>
        </a>
        <a href={GENERAL_DISCORD} target="_blank" rel="noopener noreferrer" aria-label="URnetwork Discord" title="Discord">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.3698A19.791 19.791 0 0 0 15.885 3a13.77 13.77 0 0 0-.567 1.17 18.27 18.27 0 0 0-5.632 0A12.64 12.64 0 0 0 9.112 3a19.736 19.736 0 0 0-4.434 1.372C1.874 8.54 1.114 12.6 1.494 16.603a17.76 17.76 0 0 0 5.43 2.743 13.37 13.37 0 0 0 1.3-1.78 11.36 11.36 0 0 1-2.047-.98c.172-.126.34-.256.504-.389a14.2 14.2 0 0 0 12.624 0c.165.134.332.264.504.389-.65.385-1.336.714-2.047.98.38.627.815 1.224 1.3 1.78a17.72 17.72 0 0 0 5.43-2.743c.445-4.64-.76-8.665-4.175-12.233ZM8.02 14.17c-1.23 0-2.24-1.12-2.24-2.49s.99-2.5 2.24-2.5c1.26 0 2.26 1.13 2.24 2.5 0 1.37-.99 2.49-2.24 2.49Zm7.96 0c-1.23 0-2.24-1.12-2.24-2.49s.99-2.5 2.24-2.5c1.26 0 2.26 1.13 2.24 2.5 0 1.37-.98 2.49-2.24 2.49Z" /></svg>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="UR subnet on GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
        </a>
        <a class="footer-product-link" href={PRODUCT_URL} target="_blank" rel="noopener noreferrer" aria-label="URnetwork products at ur.io">ur.io <span aria-hidden="true">↗</span></a>
    </nav>

    <div class="footer-utility">
        <p>© {year} UR Foundation</p>
        <nav class="footer-legal" aria-label={t.footer.legal}>
            <a href="/terms" aria-label={`${t.footer.terms} — available in English`}>{t.footer.terms} <span class="english-only-mark" lang="en">EN</span></a>
            <a href="/privacy" aria-label={`${t.footer.privacy} — available in English`}>{t.footer.privacy} <span class="english-only-mark" lang="en">EN</span></a>
            <a href="/vdp" aria-label={`${t.footer.vdp} — available in English`}>{t.footer.vdp} <span class="english-only-mark" lang="en">EN</span></a>
        </nav>
        {translated ? (
            <nav class="footer-langs" aria-label={t.footer.languagesAria}>
                {LANG_CODES.map(code => (
                    <a href={resolveLanguageDestination(currentPath, code).href} lang={code} data-footer-language={code} class={`footer-lang ${code === lang ? 'is-active' : ''}`} aria-current={code === lang ? 'page' : undefined}>
                        {LANGS[code].label}
                    </a>
                ))}
            </nav>
        ) : (
            <p class="footer-language-availability" lang="en"><strong>EN</strong> Available in English</p>
        )}
    </div>
</footer>

<script>
    import { resolveLanguageDestination } from '../lib/route-localization.js';

    const footerLanguageLinks = document.querySelectorAll<HTMLAnchorElement>('[data-footer-language]');

    function synchronizeFooterLanguageLinks() {
        for (const link of footerLanguageLinks) {
            const language = link.dataset.footerLanguage;
            if (language) link.setAttribute('href', resolveLanguageDestination(window.location.href, language).href);
        }
    }

    synchronizeFooterLanguageLinks();
    window.addEventListener('hashchange', synchronizeFooterLanguageLinks);
    window.addEventListener('popstate', synchronizeFooterLanguageLinks);

    for (const link of footerLanguageLinks) {
        // Refresh immediately before native new-tab gestures as well as when
        // browser history changes without a full document navigation.
        link.addEventListener('pointerdown', synchronizeFooterLanguageLinks);
        link.addEventListener('contextmenu', synchronizeFooterLanguageLinks);
        link.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') synchronizeFooterLanguageLinks();
        });
        link.addEventListener('click', (event) => {
            if (!(event instanceof MouseEvent) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

            const language = link.dataset.footerLanguage;
            if (!language) return;

            event.preventDefault();
            try { window.localStorage.setItem('ur.xyz.lang', language); } catch {}
            window.location.assign(resolveLanguageDestination(window.location.href, language).href);
        });
    }
</script>
