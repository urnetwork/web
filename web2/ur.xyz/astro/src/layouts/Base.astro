---
import '@react/App.css';
import { LANG_CODES, NON_EN_LANGS } from '../lib/i18n.js';

interface Props {
    title: string;
    description?: string;
    lang?: string;
    dir?: string;
    // page-specific schema.org nodes, merged into the site @graph
    jsonLd?: object[];
    // machine-readable alternate of this page: { href, type } (absolute or /path)
    alternate?: { href: string; type: string } | null;
    noindex?: boolean;
    // "website" (default) or "article"; article pages also pass `article`
    ogType?: string;
    article?: { publishedTime?: string; author?: string } | null;
    // per-page social card override (/path), with dimensions when known
    ogImage?: string | null;
    ogImageWidth?: number;
    ogImageHeight?: number;
}

const {
    title,
    description = 'UR — Own your privacy. Own your network.',
    lang = 'en',
    dir = 'ltr',
    jsonLd = [],
    alternate = null,
    noindex = false,
    ogType = 'website',
    article = null,
    ogImage: ogImageProp = null,
    ogImageWidth = 1200,
    ogImageHeight = 630,
} = Astro.props;

const SITE_ORIGIN = 'https://ur.xyz';
// Static builds use file-format routes (`/research.html`, `/ar.html`) while
// the public server exposes clean URLs. Publish the public form in canonical,
// Open Graph, breadcrumbs and language alternates.
const publicPath = Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '') || '/';
const canonical = new URL(publicPath, SITE_ORIGIN).href;
// scripts/generate-og.mjs renders the 1200×630 card; pages can override
const ogImage = `${SITE_ORIGIN}${ogImageProp || '/og.png'}`;
const ogAlt = `UR — ${description.length <= 120 ? description : title}`;
const alternateHref = alternate && (alternate.href.startsWith('http') ? alternate.href : `${SITE_ORIGIN}${alternate.href}`);

const OG_LOCALES = { en: 'en_US', ru: 'ru_RU', ar: 'ar_AR', zh: 'zh_CN', de: 'de_DE', es: 'es_ES' };
const ogLocale = OG_LOCALES[lang] || OG_LOCALES.en;

// Language alternates: localized pages use the same path in all six
// languages (English at the bare path, the rest under /<lang>).
const langPrefix = new RegExp(`^/(${NON_EN_LANGS.join('|')})(?=/|$)`);
const basePath = publicPath.replace(langPrefix, '') || '/';
const hasLocalizedVersion = !(
    basePath === '/docs' || basePath.startsWith('/docs/') ||
    basePath === '/investors' || basePath.startsWith('/investors/')
);
const altHref = (l) =>
    new URL(l === 'en' ? basePath : `/${l}${basePath === '/' ? '' : basePath}`, SITE_ORIGIN).href;

// Site-wide schema.org graph. The protocol is the subject; BringYour hosts the
// site (see /terms) — the WebSite node carries that relationship, pages add
// their own nodes (TechArticle, Dataset, …) via the jsonLd prop.
const graph = [
    {
        '@type': 'Organization',
        '@id': `${SITE_ORIGIN}/#org`,
        name: 'UR protocol',
        url: `${SITE_ORIGIN}/`,
        logo: `${SITE_ORIGIN}/favicon-128.png`,
        sameAs: ['https://github.com/urfoundation', 'https://github.com/urnetwork', 'https://ur.io/'],
    },
    {
        '@type': 'WebSite',
        '@id': `${SITE_ORIGIN}/#website`,
        name: 'UR protocol',
        url: `${SITE_ORIGIN}/`,
        publisher: { '@id': `${SITE_ORIGIN}/#org` },
        inLanguage: LANG_CODES,
    },
    // a flat site: every non-root page is one step below home
    ...(basePath !== '/'
        ? [{
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'UR', item: `${SITE_ORIGIN}/` },
                { '@type': 'ListItem', position: 2, name: title.replace(/\s+[—–-]\s+UR\s*$/u, ''), item: canonical },
            ],
        }]
        : []),
    ...jsonLd,
];
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content={description} />
    <meta name="application-name" content="UR" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && hasLocalizedVersion && LANG_CODES.map(l => (
        <link rel="alternate" hreflang={l} href={altHref(l)} />
    ))}
    {!noindex && hasLocalizedVersion && <link rel="alternate" hreflang="x-default" href={altHref('en')} />}
    {alternateHref && <link rel="alternate" type={alternate.type} href={alternateHref} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content="UR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    {ogType === 'article' && article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {ogType === 'article' && article?.author && <meta property="article:author" content={article.author} />}
    <meta property="og:locale" content={ogLocale} />
    {LANG_CODES.filter(l => l !== lang).map(l => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
    <!-- favicon-180.png IS 180×180; apple-touch-icon.png is actually 192×192 -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/PPNeueMontreal-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/PPNeueBit-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
        @font-face {
            font-family: 'PPNeueMontreal';
            src: url('/PPNeueMontreal-Regular.woff2') format('woff2');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'PPNeueBit';
            src: url('/PPNeueBit-Bold.woff2') format('woff2');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }
    </style>

    <title>{title}</title>

    <script type="application/ld+json" set:html={jsonLdText} />

    <!-- Page-specific head extras. -->
    <slot name="head" />

    {/* Speculation Rules: Chromium prefetches likely next navigations on
        hover ("moderate"); other engines ignore the block. Prefetch only,
        static first-party site, so a prefetched navigation has no side
        effects. Documents only — not the PDFs or machine-readable assets. */}
    <script type="speculationrules" set:html={JSON.stringify({
      prefetch: [{
        source: "document",
        where: {
          and: [
            { href_matches: "/*" },
            { not: { href_matches: "/*.(md|xml|txt|yml|pdf|zip)" } },
          ],
        },
        eagerness: "moderate",
      }],
    })} />
</head>
<body>
    <!-- Static site: navigation should do full page loads, not pushState -->
    <script is:inline>window.__ASTRO_STATIC__ = true;</script>
    <div id="root">
        <slot />
    </div>
</body>
</html>
