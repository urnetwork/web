---
import en from '@react/i18n/en.js';
import { getDisclaimerCopy } from '@react/i18n/disclaimer.js';
import '@react/components/Disclaimer.css';

interface Props { t?: any; }
const { t = en } = Astro.props;
const copy = getDisclaimerCopy(t.disclaimer);
---
<div class="disclaimer" id="disclaimer-bar">
    <p class="disclaimer-copy">
        <span>{copy.protocol}</span><a href="https://ur.io" target="_blank" rel="noopener noreferrer">{copy.products}</a>
    </p>
</div>

<script>
    const bar = document.getElementById('disclaimer-bar');
    let raf = 0;
    function update() {
        raf = 0;
        if (bar) bar.classList.toggle('disclaimer-hidden', window.scrollY > 8);
    }
    update();
    window.addEventListener('scroll', () => {
        if (!raf) raf = requestAnimationFrame(update);
    }, { passive: true });
</script>
