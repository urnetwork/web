---
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import FooterStatic from '../components/FooterStatic.astro';
import RoleBlocks from '../components/RoleBlocks.astro';
import HeroIsland from '../islands/HeroIsland.jsx';
import LaunchVideoIsland from '../islands/LaunchVideoIsland.jsx';
import HomepageIntro from '@react/components/HomepageIntro.jsx';
import NetworkDiagram, { diagramCopy } from '@react/components/NetworkDiagram.jsx';
import en from '@react/i18n/en.js';
import { sentenceClamp } from '../lib/meta.js';

const t = en;
// What a search result shows. A dictionary may supply its own
// (homepage.metaTitle / homepage.metaDescription); until it does, the English
// title names what UR is rather than repeating the nav tagline, and the
// description is the intro's opening sentences.
const title = t.homepage.metaTitle || 'UR | The decentralized privacy network on Bittensor SN25';
const description = sentenceClamp(t.homepage.metaDescription || t.homepage.intro);
// No VideoObject: the launch film opens in an overlay that mounts on demand,
// so the page's HTML carries no <video> for the markup to describe.
---
<Base title={title} description={description} lang="en">
    {/* the stored-language redirect (a visitor who chose another language
        reads this page in it) is in Base's head */}
    <div class="app">
        <DisclaimerStatic t={t} />
        <HeroIsland lang="en" client:load />

        <main class="landing-main">
            <HomepageIntro copy={t} />
            <section class="landing-overview" aria-label={t.homepage.diagramAria}>
                <NetworkDiagram client:visible={{rootMargin: "200px"}} active="subnet" lang="en" copy={diagramCopy(t)} />
                <RoleBlocks t={t} lang="en" />
            </section>
        </main>

        <FooterStatic t={t} lang="en" />
        <LaunchVideoIsland lang="en" client:load />
    </div>
</Base>

<style>
    .landing-main { position: relative; background: var(--brand-bg); }
    .landing-overview { width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 120px 0 0; }
    @media (max-width: 767px) {
        .landing-overview { width: calc(100% - 40px); padding-top: 88px; }
    }
</style>
