---
import Base from '../../layouts/Base.astro';
import DocsIsland from '../../islands/DocsIsland.jsx';
import { docs } from '@react/lib/docs.js';
import { DOC_PAGE_PATHS } from '@react/lib/docs-shared.js';
import { docDescription } from '../../lib/meta.js';
import { LASTMOD_TOKEN } from '../../lib/lastmod.js';

export function getStaticPaths() {
    // A document published as its own page (the legal documents, at /terms,
    // /privacy and /vdp) gets no second copy under /docs.
    return docs.filter(d => d.slug && !DOC_PAGE_PATHS[d.slug]).map(d => ({
        params: { slug: d.slug },
        props: {
            title: d.title,
            meta: d.meta,
            // whole-sentence and markdown-free (the raw slice leaked "> " and cut
            // mid-word); a revision line is not what the document is about, so
            // it never opens the description ("Last modified: May 8, 2025 …")
            description: d.meta.description || docDescription(
                d.content.replace(/^\s*\**\s*Last (?:modified|revised|updated)\b[^\n]*$/gim, ''),
                d.title,
            ),
        },
    }));
}

const { slug } = Astro.params;
const { title, meta, description } = Astro.props;
const url = `https://ur.xyz/docs/${slug}`;

const jsonLd = [{
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    publisher: { '@id': 'https://ur.xyz/#org' },
    author: { '@id': 'https://ur.xyz/#org' },
    inLanguage: 'en',
    // the day the page's content last changed, from the same record as the
    // sitemap's <lastmod>: the build fills it in once the page is fingerprinted
    dateModified: LASTMOD_TOKEN,
    encoding: {
        '@type': 'MediaObject',
        encodingFormat: 'text/markdown',
        contentUrl: `https://ur.xyz/docs-md/${slug}.md`,
    },
}];
---
<Base
    title={meta.title || `${title} — UR Docs`}
    breadcrumbName={title}
    description={description}
    lang="en"
    jsonLd={jsonLd}
    alternate={{ href: `/docs-md/${slug}.md`, type: 'text/markdown' }}
>
    <DocsIsland activeRoute="docs" lang="en" initialSlug={slug} client:load />
</Base>
