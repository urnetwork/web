---
import Base from '../../layouts/Base.astro';
import DocsIsland from '../../islands/DocsIsland.jsx';
import { docsIndex as listed } from '@react/lib/docs.js';

// the documents the landing page lists, in its order: the three role guides
// and the litepaper (an unlisted document, docs-shared.js, is not among them)
const jsonLd = [{
    '@type': 'CollectionPage',
    '@id': 'https://ur.xyz/docs#docs',
    name: 'UR documentation',
    url: 'https://ur.xyz/docs',
    inLanguage: 'en',
    isPartOf: { '@id': 'https://ur.xyz/#website' },
    mainEntity: {
        '@type': 'ItemList',
        numberOfItems: listed.length,
        itemListElement: listed.map((d, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: d.title,
            url: `https://ur.xyz${d.href}`,
            ...(d.meta.description ? { description: d.meta.description } : {}),
        })),
    },
}];
---
<Base
    title="UR Docs | How to become a miner, validator or network operator"
    description="How to become a miner, a validator or a network operator on Bittensor SN25, one guide per role, and the UR litepaper that explains the mechanism, each with a markdown twin."
    breadcrumbName="Docs"
    lang="en"
    jsonLd={jsonLd}
>
    <DocsIsland activeRoute="docs" lang="en" client:load />
</Base>
