---
// The Investor Centre. The body is the React component the SPA renders
// (react/src/components/pages/Investors.jsx); this page owns the head and the
// shell, matching [section].astro. The archive's search and type filter run
// in the component's handlers, so it hydrates.
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import FooterStatic from '../components/FooterStatic.astro';
import NavIsland from '../islands/NavIsland.jsx';
import InvestorsPage from '@react/components/pages/Investors.jsx';
import en from '@react/i18n/en.js';
import { investorCentre } from '@react/data/investors.js';

import '@react/components/Nav.css';

const { featured, updates, materials } = investorCentre;
const centreDocs = [featured, ...updates, ...materials].filter(
    (d, i, arr) => d && arr.findIndex((x) => x.href === d.href) === i,
);
const centreJsonLd = [{
    '@type': 'CollectionPage',
    '@id': 'https://ur.xyz/investors#centre',
    name: 'Investor Centre',
    url: 'https://ur.xyz/investors',
    inLanguage: 'en',
    isPartOf: { '@id': 'https://ur.xyz/#website' },
    mainEntity: {
        '@type': 'ItemList',
        numberOfItems: centreDocs.length,
        itemListElement: centreDocs.map((d, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: d.title,
            url: `https://ur.xyz${d.href}`,
        })),
    },
}];
---
<Base
    title="Investor Centre | UR"
    description="UR investor updates, materials, and public research: letters, the litepaper, and third-party audits, with live network dashboards."
    lang="en"
    jsonLd={centreJsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="investors" lang="en" client:load />

        <main class="section-page">
            <InvestorsPage route={{ name: 'investors', slug: null }} client:load />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
