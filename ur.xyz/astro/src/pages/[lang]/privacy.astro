---
// The legal documents are English-only (a translated contract would be a
// different contract), so /<lang>/privacy is not a page of its own: it 301s to
// /privacy. nginx answers it at the HTTP layer; this stub is the static fallback,
// like the /<lang>/docs ones.
import { NON_EN_LANGS } from '../../lib/i18n.js';

export function getStaticPaths() {
    return NON_EN_LANGS.map(lang => ({ params: { lang } }));
}

return Astro.redirect('/privacy', 301);
---
