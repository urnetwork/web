---
// The September 2026 letter to tokenholders. The body is the React component
// the SPA renders (react/src/components/pages/investors/TokenholderLetter.jsx);
// this page owns the head and the shell, matching [section].astro. The
// document is static, so it is server-rendered without hydration.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import FooterStatic from '../../components/FooterStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import InvestorsPage from '@react/components/pages/Investors.jsx';
import en from '@react/i18n/en.js';
import { investorCentre } from '@react/data/investors.js';
import { contributors } from '@react/data/contributors.js';

import '@react/components/Nav.css';

// Named explicitly rather than read from `featured`: this page is the
// September letter whatever the Investor Centre leads with next.
const letter = investorCentre.tokenholderLetter;
const canonicalUrl = `https://ur.xyz${letter.href}`;

// The letter is signed by Brien and Jack for the UR team: the authors are
// those two people, tied to the site's Organization node and their profiles.
const AUTHORS = ['Brien Colwell', 'Jack Ai-Leung'];
const authorNodes = AUTHORS.map((name) => {
    const profile = contributors.find((c) => c.name === name)?.href;
    return {
        '@type': 'Person',
        name,
        url: 'https://ur.xyz/about',
        ...(profile ? { sameAs: [profile] } : {}),
        affiliation: { '@id': 'https://ur.xyz/#org' },
    };
});

// Dated, authored and downloadable: an Article, like the letter beside it,
// rather than a generic web page (SEO3 G5).
const letterJsonLd = [{
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: letter.title,
    description: letter.summary,
    datePublished: letter.dateIso,
    author: authorNodes,
    publisher: { '@id': 'https://ur.xyz/#org' },
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    image: 'https://ur.xyz/og.png',
    encoding: {
        '@type': 'MediaObject',
        encodingFormat: 'application/pdf',
        contentUrl: `https://ur.xyz${letter.pdfHref}`,
    },
}];
---
<Base
    title={`${letter.title} | UR`}
    description={letter.summary}
    lang="en"
    ogType="article"
    article={{ publishedTime: letter.dateIso, author: AUTHORS.join(' and ') }}
    jsonLd={letterJsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="investors" lang="en" client:load />

        <main class="section-page">
            <InvestorsPage route={{ name: 'investors', slug: 'letter-to-tokenholders-september-2026' }} />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
