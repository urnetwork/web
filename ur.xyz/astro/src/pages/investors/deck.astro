---
// The investor deck, viewable in the browser. The viewer is the React
// component the SPA renders (react/src/components/pages/investors/
// DeckViewer.jsx); this page owns the head and the shell, matching
// [section].astro. Slide navigation, the keyboard and fullscreen live in the
// component's handlers, so it hydrates; the first slide and its controls are
// server-rendered from props, so the page reads the same before hydration.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import FooterStatic from '../../components/FooterStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import InvestorsPage from '@react/components/pages/Investors.jsx';
import en from '@react/i18n/en.js';
import { investorCentre } from '@react/data/investors.js';

import '@react/components/Nav.css';

const { deck } = investorCentre;
---
<Base
    title={`${deck.title} | UR`}
    description={deck.summary}
    lang="en"
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="investors" lang="en" client:load />

        <main class="section-page">
            <InvestorsPage route={{ name: 'investors', slug: 'deck' }} client:load />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
