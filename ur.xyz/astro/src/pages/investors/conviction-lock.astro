---
// The conviction-lock announcement. The body is the React component the SPA
// renders (react/src/components/pages/investors/InvestorAnnouncement.jsx);
// this page owns the head and the shell, matching [section].astro. The
// document is static, so it is server-rendered without hydration.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import FooterStatic from '../../components/FooterStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import InvestorsPage from '@react/components/pages/Investors.jsx';
import en from '@react/i18n/en.js';
import { investorCentre } from '@react/data/investors.js';

import '@react/components/Nav.css';

// Named explicitly rather than read from `featured`: this page is the
// conviction announcement whatever the Investor Centre leads with next.
const announcement = investorCentre.convictionAnnouncement;
const pdfHref = announcement.pdfHref;

// One headline for the <title>, the <h1> (rendered by the component from the
// same field) and the structured data, so the three cannot drift apart.
const { headline, description } = announcement;

// Dated, authored and downloadable: an Article, like the letter beside it,
// rather than a generic web page (SEO3 G5).
const announcementJsonLd = [{
    '@type': 'Article',
    '@id': 'https://ur.xyz/investors/conviction-lock#article',
    headline,
    description,
    datePublished: announcement.dateIso,
    // the site's Organization node (Base.astro), not a second, unlinked one
    author: { '@id': 'https://ur.xyz/#org' },
    publisher: { '@id': 'https://ur.xyz/#org' },
    mainEntityOfPage: 'https://ur.xyz/investors/conviction-lock',
    url: 'https://ur.xyz/investors/conviction-lock',
    image: 'https://ur.xyz/og.png',
    ...(pdfHref
        ? {
              encoding: {
                  '@type': 'MediaObject',
                  encodingFormat: 'application/pdf',
                  contentUrl: `https://ur.xyz${pdfHref}`,
              },
          }
        : {}),
}];
---
<Base
    title={`${headline} | UR`}
    description={description}
    lang="en"
    ogType="article"
    article={{ publishedTime: announcement.dateIso, author: 'UR Foundation' }}
    jsonLd={announcementJsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="investors" lang="en" client:load />

        <main class="section-page">
            <InvestorsPage route={{ name: 'investors', slug: 'conviction-lock' }} />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
