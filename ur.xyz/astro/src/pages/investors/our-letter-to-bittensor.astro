---
// Our Letter to Bittensor. The body is the React component the SPA renders
// (react/src/components/pages/investors/InvestorLetter.jsx); this page owns
// the head and the shell, matching [section].astro. The network-stack
// exhibit scales itself to narrow screens and opens in a zoomable dialog
// there, which runs in the component's effect, so it hydrates.
import Base from '../../layouts/Base.astro';
import DisclaimerStatic from '../../components/DisclaimerStatic.astro';
import FooterStatic from '../../components/FooterStatic.astro';
import NavIsland from '../../islands/NavIsland.jsx';
import InvestorsPage from '@react/components/pages/Investors.jsx';
import en from '@react/i18n/en.js';
import { investorCentre } from '@react/data/investors.js';
import { contributors } from '@react/data/contributors.js';

import '@react/components/Nav.css';

const { letter } = investorCentre;
// The letter is signed by Jack Ai-Leung for the UR team: the author is that
// person, tied to the site's Organization node and to his profile.
const AUTHOR = 'Jack Ai-Leung';
const authorProfile = contributors.find((c) => c.name === AUTHOR)?.href;
// The letter is an article: dated, authored, downloadable — say so in
// structured data instead of presenting it as a generic web page.
const letterJsonLd = [{
    '@type': 'Article',
    '@id': 'https://ur.xyz/investors/our-letter-to-bittensor#article',
    headline: letter.title,
    description: letter.summary,
    datePublished: letter.dateIso,
    author: {
        '@type': 'Person',
        name: AUTHOR,
        url: 'https://ur.xyz/about',
        ...(authorProfile ? { sameAs: [authorProfile] } : {}),
        affiliation: { '@id': 'https://ur.xyz/#org' },
    },
    publisher: { '@id': 'https://ur.xyz/#org' },
    mainEntityOfPage: 'https://ur.xyz/investors/our-letter-to-bittensor',
    url: 'https://ur.xyz/investors/our-letter-to-bittensor',
    image: 'https://ur.xyz/investors/og-letter.png',
    ...(letter.pdfHref
        ? {
              encoding: {
                  '@type': 'MediaObject',
                  encodingFormat: 'application/pdf',
                  contentUrl: `https://ur.xyz${letter.pdfHref}`,
              },
          }
        : {}),
}];
---
<Base
    title="Our Letter to Bittensor | UR"
    description={letter.summary}
    lang="en"
    ogType="article"
    article={{ publishedTime: letter.dateIso, author: AUTHOR }}
    ogImage="/investors/og-letter.png"
    jsonLd={letterJsonLd}
>
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="investors" lang="en" client:load />

        <main class="section-page">
            <InvestorsPage route={{ name: 'investors', slug: 'our-letter-to-bittensor' }} client:load />
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
