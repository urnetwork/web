---
// /mainnet — the SN25 mainnet launch timeline.
//
// The page body is the React component the SPA renders for this route
// (react/src/components/pages/Mainnet.jsx). It needs no script, so it is
// rendered to static HTML here, and only the nav and the summary timeline
// under the title hydrate: the summary (mainnet/MainnetSummary.jsx) marks
// "now", which only the visitor's clock knows. It is an island in the page's
// `summary` slot, given its model, computed here from the same data, so the
// island carries no data files of its own. The milestones are data
// (react/src/data/mainnet-timeline.json); the shell around them is the
// section pages' exactly, so the SPA and this render are pixel-identical.
// English-only, like /about and /reserve.
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import NavIsland from '../islands/NavIsland.jsx';
import FooterStatic from '../components/FooterStatic.astro';
import MainnetPage from '@react/components/pages/Mainnet.jsx';
import MainnetSummary from '@react/components/pages/mainnet/MainnetSummary.jsx';
import { summaryModel } from '@react/components/pages/mainnet/summary.js';
import timeline from '@react/data/mainnet-timeline.json';
import { mainnetEpochs } from '@react/data/mainnet.js';
import en from '@react/i18n/en.js';
import { LASTMOD_TOKEN } from '../lib/lastmod.js';

import '@react/components/Nav.css';

const title = 'SN25 mainnet launch timeline | UR';
const description = 'The SN25 mainnet launch by payout epoch: version 1 from October 8, then settlement v2, targeted from epoch 4 (October 30), with first claims from November 8 at the earliest.';
const summary = summaryModel(timeline.events, mainnetEpochs);
---
<Base title={title} description={description} breadcrumbName="Mainnet" lang="en">
    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="mainnet" lang="en" client:idle={{ timeout: 1000 }} />

        <main class="section-page">
            {/* "Updated" states the sitemap's lastmod: the build fills the
                token in once the page is fingerprinted (src/lib/lastmod.js) */}
            <MainnetPage route={{ name: 'mainnet', slug: null }} updated={LASTMOD_TOKEN}>
                <MainnetSummary slot="summary" model={summary} client:visible={{ rootMargin: "200px" }} />
            </MainnetPage>
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
