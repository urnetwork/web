---
import '@react/App.css';
import { LANG_CODES } from '../lib/i18n.js';
import { basePathFor, hasLocalizedVersion, publicPathFor, storedLanguageRedirectScript } from '../lib/route-localization.js';

interface Props {
    title: string;
    description?: string;
    lang?: string;
    dir?: string;
    // page-specific schema.org nodes, merged into the site @graph
    jsonLd?: object[];
    // machine-readable alternate of this page: { href, type } (absolute or /path)
    alternate?: { href: string; type: string } | null;
    noindex?: boolean;
    // "website" (default) or "article"; article pages also pass `article`
    ogType?: string;
    article?: { publishedTime?: string; author?: string } | null;
    // per-page social card override (/path), with dimensions when known
    ogImage?: string | null;
    ogImageWidth?: number;
    ogImageHeight?: number;
    // the page's name in the breadcrumb trail (default: the title without the
    // site suffix)
    breadcrumbName?: string | null;
}

const {
    title,
    description = 'UR: Own your privacy. Own the network.',
    lang = 'en',
    dir = 'ltr',
    jsonLd = [],
    alternate = null,
    noindex = false,
    ogType = 'website',
    article = null,
    ogImage: ogImageProp = null,
    ogImageWidth = 1200,
    ogImageHeight = 630,
    breadcrumbName = null,
} = Astro.props;

const SITE_ORIGIN = 'https://ur.xyz';
// Static builds use file-format routes (`/research.html`, `/ar.html`) while
// the public server exposes clean URLs. Publish the public form in canonical,
// Open Graph, breadcrumbs and language alternates.
const publicPath = publicPathFor(Astro.url.pathname);
const canonical = new URL(publicPath, SITE_ORIGIN).href;
// scripts/generate-og.mjs renders the 1200×630 card; pages can override
const ogImage = `${SITE_ORIGIN}${ogImageProp || '/og.png'}`;
const ogAlt = `UR: ${description.length <= 120 ? description : title}`;
const alternateHref = alternate && (alternate.href.startsWith('http') ? alternate.href : `${SITE_ORIGIN}${alternate.href}`);

const OG_LOCALES = { en: 'en_US', ru: 'ru_RU', ar: 'ar_AR', zh: 'zh_CN', de: 'de_DE', es: 'es_ES' };
const ogLocale = OG_LOCALES[lang] || OG_LOCALES.en;

// Language alternates exist only for routes backed by real translated pages.
// A positive allowlist keeps a newly-added English page from claiming
// unserved /<lang>/... variants by default.
const basePath = basePathFor(publicPath);
const localized = hasLocalizedVersion(basePath);
const altHref = (l) =>
    new URL(l === 'en' ? basePath : `/${l}${basePath === '/' ? '' : basePath}`, SITE_ORIGIN).href;

// Site-wide schema.org graph. UR is the subject: one Organization node that
// the WebSite, the breadcrumbs and every article's author and publisher point
// at by @id, named as the site names itself everywhere else (og:site_name,
// the breadcrumb root, the title suffix). ur.io is a different company and is
// not one of its profiles. Pages add their own nodes (TechArticle, Article,
// CollectionPage, …) via the jsonLd prop.
const ORG_ID = `${SITE_ORIGIN}/#org`;
const X_HANDLE = 'urnetwork';

// Breadcrumbs follow the URL: the home page of the page's language, the
// section a page sits in (Docs, the Investor Centre), then the page itself,
// named without the site suffix (" — UR", " | UR", " — UR Docs").
const homeUrl = lang && lang !== 'en' ? new URL(`/${lang}`, SITE_ORIGIN).href : `${SITE_ORIGIN}/`;
const PARENTS = [
    { prefix: '/docs/', name: 'Docs', path: '/docs' },
    { prefix: '/investors/', name: 'Investor Centre', path: '/investors' },
];
const parent = PARENTS.find((p) => basePath.startsWith(p.prefix));
const pageName = breadcrumbName || title.replace(/\s+[—–|-]\s+UR(?:\s+Docs)?\s*$/u, '');
const trail = basePath === '/' || noindex
    ? []
    : [
        { name: 'UR', item: homeUrl },
        ...(parent ? [{ name: parent.name, item: new URL(parent.path, SITE_ORIGIN).href }] : []),
        { name: pageName, item: canonical },
    ];

const graph = [
    {
        '@type': 'Organization',
        '@id': ORG_ID,
        name: 'UR',
        alternateName: 'UR protocol',
        url: `${SITE_ORIGIN}/`,
        logo: `${SITE_ORIGIN}/icon-512.png`,
        sameAs: ['https://github.com/urfoundation', 'https://github.com/urnetwork', `https://x.com/${X_HANDLE}`],
    },
    {
        '@type': 'WebSite',
        '@id': `${SITE_ORIGIN}/#website`,
        name: 'UR',
        alternateName: 'UR protocol',
        url: `${SITE_ORIGIN}/`,
        publisher: { '@id': ORG_ID },
        inLanguage: LANG_CODES,
    },
    ...(trail.length
        ? [{
            '@type': 'BreadcrumbList',
            itemListElement: trail.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, ...crumb })),
        }]
        : []),
    ...jsonLd,
];
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content={description} />
    <meta name="application-name" content="UR" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Indexable pages state their preview limits rather than leaving them to
        the engine's defaults — a large image preview is what carries the
        page's picture into a result or a Discover card. */}
    {!noindex && <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && localized && LANG_CODES.map(l => (
        <link rel="alternate" hreflang={l} href={altHref(l)} />
    ))}
    {!noindex && localized && <link rel="alternate" hreflang="x-default" href={altHref('en')} />}
    {alternateHref && <link rel="alternate" type={alternate.type} href={alternateHref} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content="UR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    {ogType === 'article' && article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {ogType === 'article' && article?.author && <meta property="article:author" content={article.author} />}
    <meta property="og:locale" content={ogLocale} />
    {localized && LANG_CODES.filter(l => l !== lang).map(l => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${X_HANDLE}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
    <!-- favicon-180.png IS 180×180; apple-touch-icon.png is actually 192×192 -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* The Arabic and Chinese pages set in system fonts: preloading the Latin
        faces there fetches two files the page never paints with. */}
    {!['ar', 'zh'].includes(lang) && <link rel="preload" href="/PPNeueMontreal-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    {!['ar', 'zh'].includes(lang) && <link rel="preload" href="/PPNeueBit-Bold.woff2" as="font" type="font/woff2" crossorigin />}

    <style is:global>
        @font-face {
            font-family: 'PPNeueMontreal';
            src: url('/PPNeueMontreal-Regular.woff2') format('woff2');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'PPNeueBit';
            src: url('/PPNeueBit-Bold.woff2') format('woff2');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }
    </style>

    <title>{title}</title>

    <script type="application/ld+json" set:html={jsonLdText} />

    {/* A visitor who chose another language reads the page in it: the script
        redirects a translated English page to its /<lang>/ twin and does
        nothing on a page without translations (it was inlined by the home and
        section pages, which are exactly the translated ones). */}
    <script is:inline set:html={storedLanguageRedirectScript()} />

    <!-- Page-specific head extras. -->
    <slot name="head" />

    {/* Speculation Rules: Chromium prefetches likely next navigations on
        hover ("moderate"); other engines ignore the block. Prefetch only,
        static first-party site, so a prefetched navigation has no side
        effects. Documents only — not the PDFs or machine-readable assets. */}
    <script type="speculationrules" set:html={JSON.stringify({
      prefetch: [{
        source: "document",
        where: {
          and: [
            { href_matches: "/*" },
            { not: { href_matches: "/*.(md|xml|txt|yml|pdf|zip)" } },
          ],
        },
        eagerness: "moderate",
      }],
    })} />
</head>
<body>
    <!-- Static site: navigation should do full page loads, not pushState -->
    <script is:inline>window.__ASTRO_STATIC__ = true;</script>
    <div id="root">
        <slot />
    </div>
</body>
</html>
